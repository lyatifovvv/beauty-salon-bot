{
  "name": "sebastian-beauty-salon-bot",
  "version": "1.0.0",
  "description": "Telegram bot for online booking in Sebastian beauty salon",
  "main": "dist/bot.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/bot.js",
    "dev": "ts-node-dev --respawn --transpile-only src/bot.ts",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:seed": "prisma db seed",
    "test": "jest"
  },
  "dependencies": {
    "@prisma/client": "^5.14.0",
    "bcryptjs": "^2.4.3",
    "date-fns": "^3.6.0",
