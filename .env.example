# ====================================================================
# .env.example — ШАБЛОН
# ====================================================================
# Этот файл КОММИТИТСЯ в git. Реальные значения в .env (он в .gitignore).
#
# В файле три типа полей. Внимательно посмотри на маркеры:
#   👤 ЗАПОЛНЯЕШЬ САМ — данные из письма Beget или твои настройки
#   🤖 ЗАПОЛНИТ CLAUDE — генерирует и вписывает сам при деплое
#   🔑 СПРОСИТ CLAUDE — попросит у тебя в нужный момент (токен бота, ключ API)
#
# Никаких бизнес-констант, настроек фреймворка или текстов сообщений в .env.
# Они живут в MATH_MODEL.md §2 и в config-файлах кода.
# ====================================================================


# ===== 👤 СЕРВЕР (данные из письма Beget) =====
BEGET_VPS_IP=
BEGET_VPS_USER=root
BEGET_VPS_PASSWORD=
BEGET_DOMAIN=
LETSENCRYPT_EMAIL=


# ===== 🤖 БАЗА ДАННЫХ (заполнит Claude при /deploy) =====
# НЕ ТРОГАЙ. Claude создаст пользователя БД, сгенерирует пароль и впишет сюда.
DATABASE_URL=


# ===== 🤖 БЕЗОПАСНОСТЬ (заполнит Claude при /deploy) =====
# НЕ ТРОГАЙ. Claude сгенерирует через openssl и впишет сюда.
APP_SECRET=


# ===== 🔑 ВНЕШНИЕ СЕРВИСЫ =====
# (архитектор добавит сюда нужные под твой стек поля.
#  Claude попросит тебя получить и дать ему значения когда настанет время)
TELEGRAM_BOT_TOKEN=
ADMIN_PASSWORD_HASH=

